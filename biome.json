{
  "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "include": [
      "components/**/*",
      "composable/**/*",
      "constants/**/*",
      "layouts/**/*",
      "middleware/**/*",
      "modules/**/*",
      "pages/**/*",
      "tests/composable/**/*",
      "tests/ui/**/*"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noUnusedTemplateLiteral": "off"
      }
    },
    "include": [
      "components/**/*",
      "composable/**/*",
      "constants/**/*",
      "layouts/**/*",
      "middleware/**/*",
      "modules/**/*",
      "pages/**/*",
      "tests/composable/**/*",
      "tests/ui/**/*"
    ]
  }
}
